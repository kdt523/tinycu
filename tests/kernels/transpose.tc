// out (cols x rows) = transpose of in (rows x cols), one thread per element.
kernel transpose(float* in, float* out, int rows, int cols) {
  int idx = blockIdx.x * blockDim.x + threadIdx.x;
  if (idx < rows * cols) {
    int r = idx / cols;
    int c = idx % cols;
    out[c * rows + r] = in[idx];
  }
}

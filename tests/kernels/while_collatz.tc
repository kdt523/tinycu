// bounded Collatz step count (while loop)
kernel while_collatz(int* x, int* steps, int n) {
  int i = blockIdx.x * blockDim.x + threadIdx.x;
  if (i < n) {
    int v = x[i];
    int c = 0;
    while (v != 1 && c < 1000) {
      if (v % 2 == 0) {
        v = v / 2;
      } else {
        v = 3 * v + 1;
      }
      c++;
    }
    steps[i] = c;
  }
}

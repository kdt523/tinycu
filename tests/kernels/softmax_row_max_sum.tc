// Per row (one thread each): the row maximum and sum(x - max), the first two softmax passes.
kernel softmax_row_max_sum(float* x, float* rmax, float* rsum, int rows, int cols) {
  int r = blockIdx.x * blockDim.x + threadIdx.x;
  if (r < rows) {
    float m = x[r * cols];
    for (int j = 1; j < cols; j++) {
      m = max(m, x[r * cols + j]);
    }
    float s = 0.0;
    for (int j = 0; j < cols; j++) {
      s += x[r * cols + j] - m;
    }
    rmax[r] = m;
    rsum[r] = s;
  }
}

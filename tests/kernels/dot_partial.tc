// Each thread sums 16 consecutive products a[j]*b[j]; partial has ceil(n/16) entries.
kernel dot_partial(float* a, float* b, float* partial, int n) {
  int t = blockIdx.x * blockDim.x + threadIdx.x;
  int chunks = (n + 15) / 16;
  if (t < chunks) {
    float acc = 0.0;
    for (int j = t * 16; j < t * 16 + 16 && j < n; j++) {
      acc += a[j] * b[j];
    }
    partial[t] = acc;
  }
}

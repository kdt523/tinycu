(kernel reduce_shared (params (float* in) (float* out) (int n))
  (block
    (vardecl shared float buf[256])
    (vardecl int tid threadIdx)
    (vardecl int i (+:int (*:int blockIdx blockDim) threadIdx))
    (vardecl float v 0.0f)
    (if (<:bool i n)
      (block
        (assign = v (index:float in i))))
    (assign = (index:float buf tid) v)
    (syncthreads)
    (for (vardecl int s (/:int blockDim 2)) (>:bool s 0) (assign /= s 2)
      (block
        (if (<:bool tid s)
          (block
            (assign += (index:float buf tid) (index:float buf (+:int tid s)))))
        (syncthreads)))
    (if (==:bool tid 0)
      (block
        (assign = (index:float out blockIdx) (index:float buf 0))))))

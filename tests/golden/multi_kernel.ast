(kernel scale (params (float* x) (float s) (int n))
  (block
    (vardecl int i (+:int (*:int blockIdx blockDim) threadIdx))
    (if (<:bool i n)
      (block
        (assign = (index:float x i) (*:float (index:float x i) s))))))
(kernel fill (params (int* x) (int v) (int n))
  (block
    (for (vardecl int i (+:int (*:int blockIdx blockDim) threadIdx)) (<:bool i n) (assign += i (*:int blockDim gridDim))
      (block
        (assign = (index:int x i) v)))))

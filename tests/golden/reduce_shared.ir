kernel reduce_shared(ptr %in, ptr %out, i32 %n) {
  shared f32 @buf[256]
entry:
  %in:ptr = param 0
  %out:ptr = param 1
  %n:i32 = param 2
  %4:i32 = sreg tid
  %tid:i32 = mov %4
  %6:i32 = sreg ctaid
  %7:i32 = sreg ntid
  %8:i32 = mul %6, %7
  %9:i32 = sreg tid
  %10:i32 = add %8, %9
  %i:i32 = mov %10
  %v:f32 = mov 0.0f
  %12:i1 = cmp.lt %i, %n
  condbr %12, if.then.1, if.end.1
if.then.1:
  %13:i64 = addr %in, %i, 4
  %14:f32 = load.global %13
  %v:f32 = mov %14
  br if.end.1
if.end.1:
  %15:i64 = addr @buf, %tid, 4
  store.shared %15, %v
  barrier
  %17:i32 = sreg ntid
  %18:i32 = div %17, 2
  %s:i32 = mov %18
  br for.cond.2
for.cond.2:
  %19:i1 = cmp.gt %s, 0
  condbr %19, for.body.2, for.end.2
for.body.2:
  %20:i1 = cmp.lt %tid, %s
  condbr %20, if.then.3, if.end.3
if.then.3:
  %21:i64 = addr @buf, %tid, 4
  %22:f32 = load.shared %21
  %23:i32 = add %tid, %s
  %24:i64 = addr @buf, %23, 4
  %25:f32 = load.shared %24
  %26:f32 = add %22, %25
  store.shared %21, %26
  br if.end.3
if.end.3:
  barrier
  br for.inc.2
for.inc.2:
  %27:i32 = div %s, 2
  %s:i32 = mov %27
  br for.cond.2
for.end.2:
  %28:i1 = cmp.eq %tid, 0
  condbr %28, if.then.4, if.end.4
if.then.4:
  %29:i32 = sreg ctaid
  %30:i64 = addr %out, %29, 4
  %31:i64 = addr @buf, 0, 4
  %32:f32 = load.shared %31
  store.global %30, %32
  br if.end.4
if.end.4:
  br exit
exit:
  ret
}

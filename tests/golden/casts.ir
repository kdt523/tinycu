kernel casts(ptr %f, ptr %o, i32 %n) {
entry:
  %f:ptr = param 0
  %o:ptr = param 1
  %n:i32 = param 2
  %4:i32 = sreg tid
  %i:i32 = mov %4
  %5:i1 = cmp.lt %i, %n
  condbr %5, if.then.1, if.end.1
if.then.1:
  %7:f32 = cvt.f32.i32 %i
  %8:f32 = mul %7, 0.5f
  %x:f32 = mov %8
  %10:i64 = addr %f, %i, 4
  %11:f32 = load.global %10
  %12:i32 = cvt.i32.f32 %11
  %t:i32 = mov %12
  %13:i64 = addr %o, %i, 4
  %14:f32 = mul %x, 2.0f
  %15:i32 = cvt.i32.f32 %14
  %16:i32 = add %t, %15
  store.global %13, %16
  %17:i64 = addr %f, %i, 4
  %18:i32 = neg %t
  %19:f32 = cvt.f32.i32 %18
  %20:f32 = add %19, 1500.0f
  %21:f32 = add %20, 0.00200000009f
  store.global %17, %21
  br if.end.1
if.end.1:
  br exit
exit:
  ret
}

// Block-level tree reduction in shared memory (blockDim must be 256).
kernel reduce_shared(float* in, float* out, int n) {
  shared float buf[256];
  int tid = threadIdx;
  int i = blockIdx * blockDim + threadIdx;
  float v = 0.0f;
  if (i < n) {
    v = in[i];
  }
  buf[tid] = v;
  __syncthreads();
  for (int s = blockDim / 2; s > 0; s /= 2) {
    if (tid < s) {
      buf[tid] += buf[tid + s];
    }
    __syncthreads();
  }
  if (tid == 0) {
    out[blockIdx] = buf[0];
  }
}

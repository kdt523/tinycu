(kernel casts (params (float* f) (int* o) (int n))
  (block
    (vardecl int i threadIdx)
    (if (< i n)
      (block
        (vardecl float x (* (cast float i) 0.5f))
        (vardecl int t (cast int (index f i)))
        (assign = (index o i) (+ t (cast int (* x 2.0))))
        (assign = (index f i) (+ (+ (cast float (- t)) 1.5e3) 2e-3))))))

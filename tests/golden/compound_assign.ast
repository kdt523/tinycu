(kernel compound (params (float* x) (int* y) (int n))
  (block
    (vardecl int i threadIdx)
    (if (< i n)
      (block
        (assign += (index x i) 1.0f)
        (assign -= (index x i) 2.0f)
        (assign *= (index x i) 3.0f)
        (assign /= (index x i) 4.0f)
        (assign += (index y i) 1)
        (assign -= (index y i) 1)
        (vardecl int k 0)
        (assign += k 5)
        (assign *= k 2)
        (assign /= k 3)
        (assign -= k 1)
        (assign = (index y i) k)))))

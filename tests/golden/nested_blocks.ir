kernel nested(ptr %o, i32 %n) {
entry:
  %o:ptr = param 0
  %n:i32 = param 1
  %3:i32 = sreg tid
  %i:i32 = mov %3
  %a:i32 = mov 1
  %6:i32 = add %a, 2
  %b:i32 = mov %6
  %7:i1 = cmp.lt %i, %n
  condbr %7, if.then.1, if.else.1
if.then.1:
  %8:i64 = addr %o, %i, 4
  store.global %8, %b
  br if.end.1
if.else.1:
  br if.end.1
if.end.1:
  %9:i1 = mov true
  condbr true, or.end.3, or.rhs.3
or.rhs.3:
  %9:i1 = mov false
  br or.end.3
or.end.3:
  condbr %9, if.then.2, if.end.2
if.then.2:
  br exit
if.end.2:
  br exit
exit:
  ret
}

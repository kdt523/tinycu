kernel relu(ptr %x, ptr %y, i32 %n) {
entry:
  %x:ptr = param 0
  %y:ptr = param 1
  %n:i32 = param 2
  %4:i32 = sreg ctaid
  %5:i32 = sreg ntid
  %6:i32 = mul %4, %5
  %7:i32 = sreg tid
  %8:i32 = add %6, %7
  %i:i32 = mov %8
  %9:i1 = cmp.lt %i, %n
  condbr %9, if.then.1, if.end.1
if.then.1:
  %11:i64 = addr %x, %i, 4
  %12:f32 = load.global %11
  %v:f32 = mov %12
  %13:i1 = cmp.lt %v, 0.0f
  condbr %13, if.then.2, if.end.2
if.then.2:
  %v:f32 = mov 0.0f
  br if.end.2
if.end.2:
  %14:i64 = addr %y, %i, 4
  store.global %14, %v
  br if.end.1
if.end.1:
  br exit
exit:
  ret
}

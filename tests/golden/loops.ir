kernel loops(ptr %out, i32 %n) {
entry:
  %out:ptr = param 0
  %n:i32 = param 1
  %3:i32 = sreg ctaid
  %4:i32 = sreg ntid
  %5:i32 = mul %3, %4
  %6:i32 = sreg tid
  %7:i32 = add %5, %6
  %i:i32 = mov %7
  %8:i1 = cmp.lt %i, %n
  condbr %8, if.then.1, if.end.1
if.then.1:
  %sum:i32 = mov 0
  %k:i32 = mov 0
  br for.cond.2
for.cond.2:
  %11:i1 = cmp.lt %k, 10
  condbr %11, for.body.2, for.end.2
for.body.2:
  %12:i1 = cmp.eq %k, 3
  condbr %12, if.then.3, if.end.3
if.then.3:
  br for.inc.2
if.end.3:
  %13:i1 = cmp.gt %k, 7
  condbr %13, if.then.4, if.end.4
if.then.4:
  br for.end.2
if.end.4:
  %14:i32 = add %sum, %k
  %sum:i32 = mov %14
  br for.inc.2
for.inc.2:
  %15:i32 = add %k, 1
  %k:i32 = mov %15
  br for.cond.2
for.end.2:
  %j:i32 = mov %i
  br while.cond.5
while.cond.5:
  %18:i1 = cmp.gt %j, 0
  %17:i1 = mov %18
  condbr %18, and.rhs.6, and.end.6
and.rhs.6:
  %19:i1 = cmp.lt %sum, 1000
  %17:i1 = mov %19
  br and.end.6
and.end.6:
  condbr %17, while.body.5, while.end.5
while.body.5:
  %20:i32 = rem %j, 7
  %21:i32 = add %sum, %20
  %sum:i32 = mov %21
  %22:i32 = sub %j, 1
  %j:i32 = mov %22
  br while.cond.5
while.end.5:
  br for.cond.7
for.cond.7:
  br for.body.7
for.body.7:
  br for.end.7
for.inc.7:
  br for.cond.7
for.end.7:
  %23:i64 = addr %out, %i, 4
  store.global %23, %sum
  br if.end.1
if.end.1:
  br exit
exit:
  ret
}

kernel builtins(ptr %x, ptr %y, i32 %n) {
entry:
  %x:ptr = param 0
  %y:ptr = param 1
  %n:i32 = param 2
  %4:i32 = sreg ctaid
  %5:i32 = sreg ntid
  %6:i32 = mul %4, %5
  %7:i32 = sreg tid
  %8:i32 = add %6, %7
  %i:i32 = mov %8
  %9:i1 = cmp.lt %i, %n
  condbr %9, if.then.1, if.end.1
if.then.1:
  %10:i64 = addr %x, %i, 4
  %11:i64 = addr %x, %i, 4
  %12:f32 = load.global %11
  %13:f32 = abs %12
  %14:f32 = sqrt %13
  %15:i64 = addr %x, %i, 4
  %16:f32 = load.global %15
  %17:f32 = max %16, 1.0f
  %18:f32 = add %14, %17
  %19:i64 = addr %x, %i, 4
  %20:f32 = load.global %19
  %21:f32 = min 2.0f, %20
  %22:f32 = sub %18, %21
  store.global %10, %22
  %23:i64 = addr %y, %i, 4
  %24:i64 = addr %y, %i, 4
  %25:i32 = load.global %24
  %26:i32 = sub %25, 5
  %27:i32 = abs %26
  %28:i32 = min %i, %n
  %29:i32 = sreg nctaid
  %30:i32 = max %29, 1
  %31:i32 = mul %28, %30
  %32:i32 = add %27, %31
  store.global %23, %32
  br if.end.1
if.end.1:
  br exit
exit:
  ret
}

kernel compound(ptr %x, ptr %y, i32 %n) {
entry:
  %x:ptr = param 0
  %y:ptr = param 1
  %n:i32 = param 2
  %4:i32 = sreg tid
  %i:i32 = mov %4
  %5:i1 = cmp.lt %i, %n
  condbr %5, if.then.1, if.end.1
if.then.1:
  %6:i64 = addr %x, %i, 4
  %7:f32 = load.global %6
  %8:f32 = add %7, 1.0f
  store.global %6, %8
  %9:i64 = addr %x, %i, 4
  %10:f32 = load.global %9
  %11:f32 = sub %10, 2.0f
  store.global %9, %11
  %12:i64 = addr %x, %i, 4
  %13:f32 = load.global %12
  %14:f32 = mul %13, 3.0f
  store.global %12, %14
  %15:i64 = addr %x, %i, 4
  %16:f32 = load.global %15
  %17:f32 = div %16, 4.0f
  store.global %15, %17
  %18:i64 = addr %y, %i, 4
  %19:i32 = load.global %18
  %20:i32 = add %19, 1
  store.global %18, %20
  %21:i64 = addr %y, %i, 4
  %22:i32 = load.global %21
  %23:i32 = sub %22, 1
  store.global %21, %23
  %k:i32 = mov 0
  %25:i32 = add %k, 5
  %k:i32 = mov %25
  %26:i32 = mul %k, 2
  %k:i32 = mov %26
  %27:i32 = div %k, 3
  %k:i32 = mov %27
  %28:i32 = sub %k, 1
  %k:i32 = mov %28
  %29:i64 = addr %y, %i, 4
  store.global %29, %k
  br if.end.1
if.end.1:
  br exit
exit:
  ret
}

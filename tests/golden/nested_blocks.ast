(kernel nested (params (int* o) (int n))
  (block
    (vardecl int i threadIdx)
    (block
      (vardecl int a 1)
      (block
        (vardecl int b (+:int a 2))
        (if (<:bool i n)
          (block
            (assign = (index:int o i) b))
          (block
            (block)))))
    (if (||:bool true false)
      (block
        (return)))))

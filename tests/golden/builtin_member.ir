kernel builtin_member(ptr %o, i32 %n) {
entry:
  %o:ptr = param 0
  %n:i32 = param 1
  %3:i32 = sreg ctaid
  %4:i32 = sreg ntid
  %5:i32 = mul %3, %4
  %6:i32 = sreg tid
  %7:i32 = add %5, %6
  %i:i32 = mov %7
  %9:i32 = sreg ctaid
  %10:i32 = sreg ntid
  %11:i32 = mul %9, %10
  %12:i32 = sreg tid
  %13:i32 = add %11, %12
  %j:i32 = mov %13
  %15:i1 = cmp.lt %i, %n
  %14:i1 = mov %15
  condbr %15, and.rhs.2, and.end.2
and.rhs.2:
  %16:i1 = cmp.eq %i, %j
  %14:i1 = mov %16
  br and.end.2
and.end.2:
  condbr %14, if.then.1, if.end.1
if.then.1:
  %17:i64 = addr %o, %i, 4
  %18:i32 = sreg nctaid
  %19:i32 = sreg nctaid
  %20:i32 = add %18, %19
  %21:i32 = sreg ntid
  %22:i32 = add %20, %21
  store.global %17, %22
  br if.end.1
if.end.1:
  br exit
exit:
  ret
}

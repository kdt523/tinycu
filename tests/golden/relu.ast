(kernel relu (params (float* x) (float* y) (int n))
  (block
    (vardecl int i (+:int (*:int blockIdx blockDim) threadIdx))
    (if (<:bool i n)
      (block
        (vardecl float v (index:float x i))
        (if (<:bool v 0.0f)
          (block
            (assign = v 0.0)))
        (assign = (index:float y i) v)))))

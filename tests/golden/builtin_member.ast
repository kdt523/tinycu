(kernel builtin_member (params (int* o) (int n))
  (block
    (vardecl int i (+:int (*:int blockIdx blockDim) threadIdx))
    (vardecl int j (+:int (*:int blockIdx blockDim) threadIdx))
    (if (&&:bool (<:bool i n) (==:bool i j))
      (block
        (assign = (index:int o i) (+:int (+:int gridDim gridDim) blockDim))))))

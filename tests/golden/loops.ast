(kernel loops (params (int* out) (int n))
  (block
    (vardecl int i (+ (* blockIdx blockDim) threadIdx))
    (if (< i n)
      (block
        (vardecl int sum 0)
        (for (vardecl int k 0) (< k 10) (assign += k 1)
          (block
            (if (== k 3)
              (block
                (continue)))
            (if (> k 7)
              (block
                (break)))
            (assign += sum k)))
        (vardecl int j i)
        (while (&& (> j 0) (< sum 1000))
          (block
            (assign = sum (+ sum (% j 7)))
            (assign -= j 1)))
        (for () () ()
          (block
            (break)))
        (assign = (index out i) sum)))))

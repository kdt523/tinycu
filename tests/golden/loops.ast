(kernel loops (params (int* out) (int n))
  (block
    (vardecl int i (+:int (*:int blockIdx blockDim) threadIdx))
    (if (<:bool i n)
      (block
        (vardecl int sum 0)
        (for (vardecl int k 0) (<:bool k 10) (assign += k 1)
          (block
            (if (==:bool k 3)
              (block
                (continue)))
            (if (>:bool k 7)
              (block
                (break)))
            (assign += sum k)))
        (vardecl int j i)
        (while (&&:bool (>:bool j 0) (<:bool sum 1000))
          (block
            (assign = sum (+:int sum (%:int j 7)))
            (assign -= j 1)))
        (for () () ()
          (block
            (break)))
        (assign = (index:int out i) sum)))))
